[{"title":"My First Post","permalink":"https://cometadata.github.io/comet-website/posts/my-first-post-copy-2/","media":"https://cometadata.github.io/comet-website/images/demo/placeholder-media.svg","date":"2026-05-11","summary":"\u003cdiv class=\"article-intro\"\u003e\r\n    \u003ch3 id=\"unlocking-author-affiliation-metadata-for-all-of-arxiv\"\u003eUnlocking Author-Affiliation Metadata for All of arXiv\u003c/h3\u003e\n\u003cp\u003eThe COMET team is pleased to share results from an exciting line of work we have recently completed, focused on unlocking author-affiliation metadata from preprints. Specifically, we have trained a small, open-weight large language model (LLM) that achieves state-of-the-art performance on author-affiliation extraction for arXiv works.\u003c/p\u003e\n\u003cp\u003eWith this approach, we have for the first time produced open author-affiliation metadata for the full arXiv corpus as of December 2025, enabling community use and allowing for direct improvements to persistent identifier metadata. The trained model and dataset are openly available and free to use.\u003c/p\u003e","authors":["Archie"],"tags":["red","blue"],"categories":["Category A","Category B"]},{"title":"My First Post","permalink":"https://cometadata.github.io/comet-website/posts/my-first-post-copy-3/","media":"https://cometadata.github.io/comet-website/images/demo/placeholder-media.svg","date":"2026-05-11","summary":"\u003cp\u003elorem ipsum\u003c/p\u003e","authors":["Archie"],"tags":["red","blue"],"categories":["Category A","Category B"]},{"title":"My First Post","permalink":"https://cometadata.github.io/comet-website/posts/my-first-post-copy-4/","media":"https://cometadata.github.io/comet-website/images/demo/placeholder-media.svg","date":"2026-05-11","summary":"\u003cp\u003elorem ipsum\u003c/p\u003e","authors":["Archie"],"tags":["red","blue"],"categories":["Category A","Category B"]},{"title":"My First Post","permalink":"https://cometadata.github.io/comet-website/posts/my-firs